# Biến môi trường cho Docker Compose.
# Sao chép thành .env (hoặc chạy scripts/setup.sh | scripts/setup.ps1) rồi đặt mật khẩu.
# KHÔNG commit file .env.

COMPOSE_PROJECT_NAME=mini-apartment

# Cổng truy cập ứng dụng: http://localhost:8080
APP_PORT=8080

# Cổng MySQL mở ra máy host (chỉ bind 127.0.0.1)
DB_FORWARD_PORT=3307

DB_DATABASE=mini_apartment
DB_USERNAME=mini_apartment
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Tự chạy `php artisan migrate` khi container app khởi động
RUN_MIGRATIONS=true
