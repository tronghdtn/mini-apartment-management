<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Database test riêng: kết nối mysql_test (config/database.php) — database + tài khoản cố định mini_apartment_test.
             Đặt cả <server> lẫn <env force>: Laravel đọc $_SERVER trước, và trong container app
             biến DB_DATABASE=mini_apartment có sẵn trong $_SERVER. tests/TestCase.php chặn mọi cấu hình khác. -->
        <server name="DB_CONNECTION" value="mysql_test"/>
        <server name="DB_DATABASE" value="mini_apartment_test"/>
        <server name="DB_URL" value=""/>
        <env name="DB_CONNECTION" value="mysql_test" force="true"/>
        <env name="DB_DATABASE" value="mini_apartment_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- Không đọc config cache (bootstrap/cache/config.php) của web đang chạy: cache đó chứa sẵn
             kết nối mysql → mini_apartment và bỏ qua mọi biến ở trên. Trỏ tới một file không bao giờ tồn tại
             để test luôn nạp config từ config/*.php với biến của phpunit. -->
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/config.phpunit-never-cached.php"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.phpunit-never-cached.php" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
