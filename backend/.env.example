APP_NAME="Mini Apartment Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Timestamp lưu UTC; ngày lịch nghiệp vụ (kỳ, hạn, prorata) theo APP_BUSINESS_TIMEZONE
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Giá trị dưới đây dùng khi chạy artisan trên máy host, kết nối tới MySQL trong Docker (cổng DB_FORWARD_PORT).
# Khi chạy trong container, docker-compose.yml ghi đè DB_HOST=mysql, DB_PORT=3306 và thông tin đăng nhập từ ../.env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=mini_apartment
DB_USERNAME=mini_apartment
DB_PASSWORD=

# PHPUnit dùng kết nối mysql_test: database + tài khoản cố định mini_apartment_test (config/database.php)
DB_TEST_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum SPA: domain (kèm cổng) của frontend được xác thực bằng session cookie.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# MVP không chạy queue worker: job/notification thực thi đồng bộ (DB-D23)
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Docker Compose đặt MAIL_MAILER=smtp, MAIL_HOST=mailpit, MAIL_PORT=1025 (xem http://localhost:8025).
# Chạy ngoài Docker có thể giữ log: thư nằm trong storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@miniapart.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
